msgctxt "Addon Summary"
msgid "Pluto.tv PVR Client"
msgstr "PVR-клієнт Pluto.tv"

msgctxt "Addon Description"
msgid "Pluto.tv PVR Client. Note: This is not an official pluto.tv add-on and not related to pluto.tv. It was developed by volunteers."
msgstr "PVR-клієнт Pluto.tv. Примітка: це неофіційний додаток pluto.tv і він не пов’язаний з pluto.tv. Він був розроблений волонтерами."

msgctxt "#30001"
msgid "Playback"
msgstr "Відтворення"

msgctxt "#30002"
msgid "Channels"
msgstr "Канали"

msgctxt "#30008"
msgid "First channel number"
msgstr "Номер першого каналу"

msgctxt "#30009"
msgid "Workaround for broken streams (requires inputstream.adaptive > 21.4.5)"
msgstr "Тимчасове рішення для пошкоджених потоків (потрібен inputstream.adaptive > 21.4.5)"

msgctxt "#30010"
msgid "Coloured channel logos"
msgstr "Кольорові логотипи каналів"

msgctxt "#30040"
msgid "Debug"
msgstr "Налагодження"

msgctxt "#30043"
msgid "Client ID"
msgstr "ID клієнта"

msgctxt "#30100"
msgid "Category containing playback settings"
msgstr "Категорія, що містить налаштування відтворення"

msgctxt "#30101"
msgid "Enable special stream handling to avoid hangs during playback."
msgstr "Увімкнути спеціальну обробку потоку, щоб уникнути зависань під час відтворення."

msgctxt "#30200"
msgid "Category containing channel settings"
msgstr "Категорія, що містить налаштування каналу"

msgctxt "#30201"
msgid "The number for the first channel. Useful if you have multiple PVR clients enabled - to group the channels from the different clients."
msgstr "Номер першого каналу. Корисно, якщо у вас увімкнено кілька PVR-клієнтів, щоб групувати канали з різних клієнтів."

msgctxt "#30202"
msgid "Use coulored channel logos, if available."
msgstr "Використовувати кольорові логотипи каналів, якщо доступно."

msgctxt "#30300"
msgid "Category containing debug settings"
msgstr "Категорія, що містить налаштування налагодження"

#~ msgctxt "#30001"
#~ msgid "General"
#~ msgstr "Загальні"
