msgctxt "Addon Summary"
msgid "Pluto.tv PVR Client"
msgstr "Klient PVR pro Pluto.tv"

msgctxt "Addon Description"
msgid "Pluto.tv PVR Client. Note: This is not an official pluto.tv add-on and not related to pluto.tv. It was developed by volunteers."
msgstr "Klient PVR pro Pluto.tv. Poznámka: Toto není oficiální doplněk pluto.tv a nemá se službou pluto.tv žádnou souvislost. Vyvinuli jej dobrovolníci."

msgctxt "#30001"
msgid "Playback"
msgstr "Přehrávání"

msgctxt "#30002"
msgid "Channels"
msgstr "Kanály"

msgctxt "#30008"
msgid "First channel number"
msgstr "Číslo prvního kanálu"

msgctxt "#30009"
msgid "Workaround for broken streams (requires inputstream.adaptive > 21.4.5)"
msgstr "Náhradní řešení pro nefunkční streamy (vyžaduje inputstream.adaptive > 21.4.5)"

msgctxt "#30010"
msgid "Coloured channel logos"
msgstr "Barevná loga kanálů"

msgctxt "#30040"
msgid "Debug"
msgstr "Ladění"

msgctxt "#30043"
msgid "Client ID"
msgstr "ID klienta"

msgctxt "#30100"
msgid "Category containing playback settings"
msgstr "Kategorie obsahující nastavení přehrávání"

msgctxt "#30101"
msgid "Enable special stream handling to avoid hangs during playback."
msgstr "Povoluje speciální zpracování streamů, aby se předešlo zasekávání při přehrávání."

msgctxt "#30200"
msgid "Category containing channel settings"
msgstr "Kategorie obsahující nastavení kanálů"

msgctxt "#30201"
msgid "The number for the first channel. Useful if you have multiple PVR clients enabled - to group the channels from the different clients."
msgstr "Číslo prvního kanálu. Užitečné, pokud máte povoleno více klientů PVR a chcete seskupit kanály z různých klientů."

msgctxt "#30202"
msgid "Use coulored channel logos, if available."
msgstr "Použije barevná loga kanálů, pokud jsou dostupná."

msgctxt "#30300"
msgid "Category containing debug settings"
msgstr "Kategorie obsahující nastavení ladění"

